# Облачный OpenAI-совместимый API (OpenAI / DeepSeek / vLLM / OpenRouter)
# Если ключ не задан, система автоматически переключится на Ollama или локальный Rule-Based движок
# PISHOVICHOK_OPENAI_API_KEY=your_api_key_here
PISHOVICHOK_OPENAI_BASE_URL=https://api.openai.com/v1
PISHOVICHOK_LLM_MODEL=gpt-4o-mini

# Локальная Ollama (второй уровень фолбэка)
# В Docker для доступа к Ollama на хосте используется host.docker.internal
# PISHOVICHOK_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
PISHOVICHOK_OLLAMA_MODEL=qwen2.5:7b

# Принудительный автономный режим без обращений к LLM (true / false)
PISHOVICHOK_FORCE_RULE_BASED_LLM=false

# Параметры веб-интерфейса NiceGUI
PISHOVICHOK_UI_PORT=8080
PISHOVICHOK_SKETCHER_BACKEND=jsme
